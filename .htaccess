# Verissimo Pratas — React SPA (loja + /admin) — Hostinger

DirectoryIndex index.html

Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # API PHP (nunca vira index.html)
  RewriteRule ^api/ - [L]

  # Arquivos estáticos de mídia
  RewriteRule \.(?:jpg|jpeg|png|webp|gif|svg|css|js|woff2?|ico)$ - [L]

  # Arquivos e pastas reais
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # React Router: /admin/login, /produtos, etc.
  RewriteRule ^ index.html [L]
</IfModule>
